{"root":{"data":{"id":"dbwl1jeyzgw0","created":1754609175339,"text":"上下文不忠实性"},"children":[{"data":{"id":"dbwl1nh2gk00","created":1754609184173,"text":"内在幻觉"},"children":[{"data":{"id":"dbwl28vvvg80","created":1754609230782,"text":"Semantic Frame Errors（语义框架错误）"},"children":[{"data":{"id":"dbwl29mh9k00","created":1754609232390,"text":"Predicate Error (PredE)谓词错误","note":"动词表达错误，比如原文里是“批准”，但是输出是“拒绝”","layout_right_offset":{"x":-187,"y":0}},"children":[{"data":{"id":"dbwsx1y7oe00","created":1754631392743,"text":"Text Summarization（摘要生成）","layout_right_offset":{"x":-51,"y":0},"note":"需理解原文事件动词/态度等，错误地改变动词行为构成谓词错误。"},"children":[]},{"data":{"id":"dbwsx2oen540","created":1754631394327,"text":"Machine Translation（机器翻译）","note":"翻译的动词含义错误，容易发生 PredE。"},"children":[]},{"data":{"id":"dbwsx3a8ltc0","created":1754631395647,"text":"Dialogue Generation（对话生成）","note":"需依赖上下文进行动词生成，错词即错误。"},"children":[]}]},{"data":{"id":"dbwl2hvhubc0","created":1754609250349,"text":"Entity Error\n(EntE)主体错误","note":"输出的事件主体出错了，比如原文说的是新冠，结果输出出来成埃博拉了"},"children":[{"data":{"id":"dbwt697u2dk0","created":1754632113840,"text":"Dialogue Generation","layout_right_offset":{"x":32,"y":0},"note":"角色身份或背景混淆。"},"children":[]},{"data":{"id":"dbwt69zqrlc0","created":1754632115528,"text":"Question Generation","note":"若实体与上下文引用不一致则出错。"},"children":[]},{"data":{"id":"dbwt6at5szk0","created":1754632117306,"text":"Paraphrase Generation（复述生成）","note":"需准确保留实体语义。"},"children":[]}]},{"data":{"id":"dbwl2jvcsuw0","created":1754609254694,"text":"Circumstance\nError (CircE)情景错误"},"children":[{"data":{"id":"dbwlw1nbxb40","created":1754611565952,"text":"时间漂移"},"children":[]},{"data":{"id":"dbwlw2ifcxk0","created":1754611567832,"text":"地点漂移"},"children":[]},{"data":{"id":"dbwlw3agx2o0","created":1754611569528,"text":"条件漂移","expandState":"expand"},"children":[]}]}]},{"data":{"id":"dbwl2fqm5y00","created":1754609245701,"text":"Discourse Errors（篇章错误）"},"children":[{"data":{"id":"dbwl2le95w00","created":1754609258014,"text":"Co-reference Error(CorefE)共指错误","note":"代词指代错误，如“they”指代不明，指代错误"},"children":[{"data":{"id":"dbwt8lye2k80","created":1754632298296,"text":"Dialogue Generation","layout_right_offset":{"x":72,"y":0},"note":"多轮指代一致性问题频发"},"children":[]},{"data":{"id":"dbwt8mxzg800","created":1754632300448,"text":"Essay Generation（文章生成）","note":"篇章中指代错误影响理解"},"children":[]},{"data":{"id":"dbwt8n4vy740","created":1754632300865,"text":"Question Generation","note":"若错误指代先前内容则构成 CorefE"},"children":[]}]},{"data":{"id":"dbwl2mcibvk0","created":1754609260085,"text":"Discourse Link Error(LinkE)链接错误","note":"上下句间逻辑关系确缺失，比如前后句顺序混乱等"},"children":[{"data":{"id":"dbwta06d1j40","created":1754632407617,"text":"Essay Generation","note":"上下句连接不当或逻辑跳跃"},"children":[]},{"data":{"id":"dbwta0ehwkw0","created":1754632408109,"text":"Dialogue Generation","note":"上下轮缺乏逻辑因果关系或对话突然跳转"},"children":[]}]}]}]},{"data":{"id":"dbwl2571aug0","created":1754609222749,"text":"外在幻觉"},"children":[{"data":{"id":"dbwlxwcxx9c0","created":1754611711168,"text":"Factual Extrinsic Error（事实型外在幻觉）","note":" \n输入里没提到，输出里“自动补充”了，且补充的这个事虽然在上下文里没有，但是在现实世界里可能存在"},"children":[{"data":{"id":"dbwtb9iho540","created":1754632506305,"text":"Text Summarization","note":"补充了上下文未提但真实存在的细节"},"children":[]},{"data":{"id":"dbwtb9pdrds0","created":1754632506722,"text":"News Generation","note":"加入背景常识或数据（如“病毒致死率”）没在输入中出现"},"children":[]}]},{"data":{"id":"dbwlxxewscg0","created":1754611713464,"text":"Non-Factual Extrinsic Error（虚假型外在幻觉）","note":" \n同样输出里“自动补充”了输入里面没有的事情，但是这个事情在现实世界里也没有或无从查证"},"children":[{"data":{"id":"dbwsg610uy80","created":1754630069430,"text":"无中生有型","priority":1,"note":"我认为可以代表那些在现实世界压根不存在的事情被“胡说”出来了"},"children":[{"data":{"id":"dbwtbvg2x400","created":1754632554049,"text":"Dialogue Generation","note":"产生用户从未说过的内容"},"children":[]},{"data":{"id":"dbwtc0h7ue80","created":1754632565001,"text":"Essay Generation / Story Generation","note":"添加世界上不存在的知识、角色或事件"},"children":[]},{"data":{"id":"dbwtc0n19oo0","created":1754632565353,"text":"Poetry Generation","note":"诗歌内容若假借史实也可能属于此类"},"children":[]}]},{"data":{"id":"dbwsg6ws7ww0","created":1754630071350,"text":"事实错误型","priority":2,"note":"现实里有，但是说的离现实世界的真相还有点差距和错误"},"children":[{"data":{"id":"dbwtdivpxoo0","created":1754632683425,"text":"News Generation","note":"引用了错误时间、地点、政策、人物等"},"children":[]},{"data":{"id":"dbwtdj4axu00","created":1754632683944,"text":"Machine Translation（少见，但也可能）","note":"加入错误解释或补充"},"children":[]}]},{"data":{"id":"dbwshj2x5fk0","created":1754630176207,"text":"模糊废话型","priority":3,"note":"弱化上下文对内容的约束性，属于全是废话"},"children":[{"data":{"id":"dbwte78hp8w0","created":1754632736440,"text":"Dialogue Generation"},"children":[]},{"data":{"id":"dbwte7fe8ts0","created":1754632736857,"text":"分支主题"},"children":[]},{"data":{"id":"dbwte7jmdq80","created":1754632737113,"text":"分支主题"},"children":[]}]}]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}